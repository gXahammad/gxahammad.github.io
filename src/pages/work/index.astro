---
import Arrow from '../../components/Arrow.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getWorkPage, projectCategories } from '../../lib/content';
import { slugify, url } from '../../lib/utils';

const page = getWorkPage();
const projects = await getProjects();
const categories = projectCategories(projects, page.categories);
const L = page.labels;
---

<Base title={page.title} description={page.seoDescription || page.intro}>
  <header class="wrap grid page-head">
    <h1 class="display page-head__title">
      {page.title}<sup class="page-head__count tabular">{projects.length}</sup>
    </h1>
    {page.intro && <p class="lead page-head__intro">{page.intro}</p>}
  </header>

  {
    projects.length ? (
      <section class="wrap" data-work data-default-view={page.defaultView}>
        <div class="toolbar">
          {page.showFilters && categories.length > 1 ? (
            <div class="chips" role="group" aria-label={L.category}>
              <button class="chip" type="button" data-filter="all" aria-pressed="true">
                {L.all}
              </button>
              {categories.map((category) => (
                <button class="chip" type="button" data-filter={category.slug} aria-pressed="false">
                  {category.name}
                </button>
              ))}
            </div>
          ) : (
            <span></span>
          )}
          <div class="chips" role="group" aria-label={`${L.grid} / ${L.index}`}>
            <button class="chip" type="button" data-view="grid" aria-pressed={page.defaultView === 'grid' ? 'true' : 'false'}>
              {L.grid}
            </button>
            <button class="chip" type="button" data-view="index" aria-pressed={page.defaultView === 'index' ? 'true' : 'false'}>
              {L.index}
            </button>
          </div>
        </div>

        <div class="card-grid" data-panel="grid" hidden={page.defaultView !== 'grid'}>
          {projects.map((project) => (
            <ProjectCard project={project} headingLevel={2} sizes="(min-width: 1100px) 30vw, (min-width: 600px) 46vw, 92vw" />
          ))}
        </div>

        <div data-panel="index" hidden={page.defaultView !== 'index'}>
          <div class="index-head eyebrow" aria-hidden="true">
            <span>{L.col_year}</span>
            <span>{L.col_title}</span>
            <span>{L.col_category}</span>
            <span>{L.col_location}</span>
            <span></span>
          </div>
          <ul class="index-list">
            {projects.map((project) => (
              <li data-categories={project.categories.map(slugify).join(' ')}>
                <a class="index-row" href={url(`/work/${project.slug}/`)}>
                  <span class="index-row__year tabular">{project.year}</span>
                  <span class="index-row__title">{project.title}</span>
                  <span class="index-row__cat">{project.categories.join(', ')}</span>
                  <span class="index-row__loc">{project.location}</span>
                  <span class="index-row__arrow">
                    <Arrow />
                  </span>
                </a>
                <template>
                  <Img src={project.cardImage || project.cover} sizes="380px" widths={[380, 760]} />
                </template>
              </li>
            ))}
          </ul>
        </div>
        <div class="index-preview media" aria-hidden="true" data-preview></div>
      </section>
    ) : (
      <p class="wrap lead">{L.empty}</p>
    )
  }
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-work]');

  if (root) {
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const views = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-categories]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const defaultView = root.dataset.defaultView || 'grid';

    const params = new URLSearchParams(window.location.search);
    let filter = params.get('category') ?? 'all';
    if (!filters.some((button) => button.dataset.filter === filter)) filter = 'all';
    let view = params.get('view') ?? defaultView;
    if (view !== 'grid' && view !== 'index') view = defaultView;

    const apply = () => {
      filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
      views.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
      items.forEach((item) => {
        const categories = (item.dataset.categories ?? '').split(' ');
        item.hidden = filter !== 'all' && !categories.includes(filter);
      });
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== view));

      const query = new URLSearchParams(window.location.search);
      if (filter === 'all') query.delete('category');
      else query.set('category', filter);
      if (view === defaultView) query.delete('view');
      else query.set('view', view);
      const search = query.toString();
      history.replaceState(null, '', `${window.location.pathname}${search ? `?${search}` : ''}`);
    };

    filters.forEach((button) =>
      button.addEventListener('click', () => {
        filter = button.dataset.filter ?? 'all';
        apply();
      }),
    );
    views.forEach((button) =>
      button.addEventListener('click', () => {
        view = button.dataset.view ?? 'grid';
        apply();
      }),
    );
    apply();

    // Index view: a small picture follows the pointer over each row.
    const preview = root.querySelector<HTMLElement>('[data-preview]');
    if (preview && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      root.querySelectorAll<HTMLElement>('.index-row').forEach((row) => {
        const template = row.parentElement?.querySelector('template');
        row.addEventListener('mouseenter', () => {
          preview.replaceChildren(template ? template.content.cloneNode(true) : '');
          preview.classList.add('is-visible');
        });
        row.addEventListener('mouseleave', () => preview.classList.remove('is-visible'));
        row.addEventListener('mousemove', (event) => {
          const width = preview.offsetWidth;
          const height = preview.offsetHeight;
          const x = Math.min(event.clientX + 28, window.innerWidth - width - 16);
          const y = Math.min(Math.max(event.clientY - height / 2, 16), window.innerHeight - height - 16);
          preview.style.setProperty('--x', `${x}px`);
          preview.style.setProperty('--y', `${y}px`);
        });
      });
    }
  }
</script>
