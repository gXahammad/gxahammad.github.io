---
interface Props {
  dir?: 'right' | 'left' | 'up' | 'down' | 'up-right';
}

const { dir = 'right' } = Astro.props;
const angle = { right: 0, down: 90, left: 180, up: 270, 'up-right': -45 }[dir];
---

<svg class={`arrow arrow--${dir}`} width="0.85em" height="0.85em" viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <g transform={`rotate(${angle} 8 8)`}>
    <path d="M1.5 8h12.2M9.2 3.4 13.8 8l-4.6 4.6" stroke="currentColor" stroke-width="1.3"></path>
  </g>
</svg>
